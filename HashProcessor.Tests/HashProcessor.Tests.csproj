<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MariaDb" Version="4.13.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HashProcessor.Api\HashProcessor.Api.csproj" />
    <ProjectReference Include="..\HashProcessor.Contracts\HashProcessor.Contracts.csproj" />
    <ProjectReference Include="..\HashProcessor.Database\HashProcessor.Database.csproj" />
    <ProjectReference Include="..\HashProcessor.Messaging\HashProcessor.Messaging.csproj" />
    <ProjectReference Include="..\HashProcessor.Worker\HashProcessor.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\HashProcessor.Database\Scripts\*.sql"
          Link="Scripts\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
